{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "Puft Docs",
    "colors": {
        "primary": "#2257bc",
        "light": "#2257bc",
        "dark": "#2257bc"
    },
    "favicon": "/favicon.svg",
    "navigation": {
        "groups": [
            {
                "group": "GENERAL",
                "pages": [
                    "index",
                    {
                        "group": "Get Started",
                        "pages": [
                            "get-started/projects"
                        ]
                    },
                    {
                        "group": "Issue tracking",
                        "pages": [
                            "issues/defects"
                        ]
                    }
                ]
            },
            {
                "group": "TEST MANAGEMENT",
                "pages": [
                    {
                        "group": "Repository",
                        "pages": [
                            "test-management/repository/folder",
                            {
                                "group": "Test case",
                                "pages": [
                                    "test-management/repository/cases/case",
                                    "test-management/repository/cases/steps",
                                    "test-management/repository/cases/call-case",
                                    "test-management/repository/cases/shared-steps"
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "group": "AUTOMATION",
                "pages": [
                    "automation/run/run",
                    {
                        "group": "Test Cases",
                        "pages": [
                            "automation/cases/classic",
                            "automation/cases/record",
                            "automation/cases/thedore"
                        ]
                    },
                    "automation/reports/reports"
                ]
            },
            {
                "group": "ADMINISTRATION",
                "pages": [
                    {
                        "group": "Workspace",
                        "pages": [
                            "administration/workspace/users",
                            "administration/workspace/groups",
                            "administration/workspace/roles",
                            "administration/workspace/statuses",
                            "administration/workspace/test-environments"
                        ]
                    },
                    {
                        "group": "Integration",
                        "pages": [
                            "administration/integration/jira",
                            "administration/integration/slack",
                            "administration/integration/bitrise",
                            "administration/integration/bitbucket",
                            "administration/integration/github",
                            "administration/integration/gitlab"
                        ]
                    }
                ]
            }
        ],
        "global": {
            "anchors": []
        }
    },
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "navbar": {
        "links": [
            {
                "label": "Support",
                "href": "mailto:hi@mintlify.com"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Dashboard",
            "href": "https://dashboard.mintlify.com"
        }
    },
    "contextual": {
        "options": [
            "copy",
            "view",
            "chatgpt",
            "claude",
            "perplexity",
            "mcp",
            "cursor",
            "vscode"
        ]
    },
    "footer": {
        "socials": {
            "x": "https://x.com/mintlify",
            "github": "https://github.com/mintlify",
            "linkedin": "https://linkedin.com/company/mintlify"
        }
    }
}